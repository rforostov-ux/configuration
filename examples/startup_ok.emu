# Стартовый скрипт без ошибок: каждая команда выполняется и показывается
# в окне вместе с выводом, как будто её вводит пользователь.
# Работает с любой VFS, в том числе без параметра --vfs.

# 1. Команды без аргументов и с аргументами
ls
ls /
cd /
vfs-info

# 2. Переменные окружения: неопределённая переменная даёт пустую строку,
# поэтому "$NO_SUCH_VARIABLE/" превращается в "/"
cd "$NO_SUCH_VARIABLE/"
ls ${NO_SUCH_VARIABLE}

# 3. Кавычки: в одинарных подстановки нет, в двойных пробелы сохраняются
ls '/'
cd "."

# 4. Комментарий в конце строки отбрасывается
cd .. # этот текст не попадёт в аргументы
