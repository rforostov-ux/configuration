# Стартовый скрипт без ошибок: каждая команда выполняется и показывается
# в окне вместе с выводом, как будто её вводит пользователь.

# 1. Команды-заглушки без аргументов и с аргументами
ls
ls -l /tmp
cd /tmp

# 2. Раскрытие переменных окружения реальной ОС: в Linux/macOS задана
# HOME и USER, в Windows - USERPROFILE и USERNAME, остальные пусты
ls $HOME $USERPROFILE
cd "$HOME/my dir"
ls ${USER}_x $USERNAME

# 3. В одинарных кавычках подстановки нет, пустые кавычки дают аргумент
ls '$HOME' ""

# 4. Комментарий в конце строки отбрасывается
cd /tmp # этот текст не попадёт в аргументы
