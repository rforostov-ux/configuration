# Этап 3: проверка VFS и всех команд этапов 1-3.
# Запуск: run.bat --vfs examples/vfs/deep.xml --script examples/startup_vfs.emu
# Команда exit здесь не вызывается, потому что она сразу закрывает окно.
# Её режимы (exit, exit 3) проверяют examples/startup_exit.emu и
# scripts/test_exit_code.

# 1. Служебная команда: какая VFS загружена и сколько в ней узлов
vfs-info

# 2. ls (пока заглушка, логика - на этапе 4): без аргументов,
# с ключом и путём, с несколькими путями
ls
ls -l /home/user
ls /home /home/guest/docs/drafts/old

# 3. cd (пока заглушка): путь и переменная окружения
cd /home/guest/docs
cd "$HOME"

# 4. Парсер: переменные, кавычки, пустой аргумент, комментарий в конце
ls "$HOME" '$HOME' "" # этот комментарий не попадёт в аргументы

# 5. Обработка ошибок: vfs-info не принимает аргументы.
# Скрипт остановится на этой строке, следующая не выполнится.
vfs-info лишний-аргумент
ls эта-строка-не-будет-выполнена
